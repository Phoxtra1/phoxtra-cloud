# Appwrite & Environment Secrets
.env
.env.*
!.env.example
appwrite/.env
appwrite/.env.*
!appwrite/.env.example

# SSL & Security Credentials (Private keys & certificates containing secrets)
*.key
*.pem
*.pfx
*.p12
*.crt
ssl/*.key
ssl/*.pem
ssl/*.crt
!ssl/.gitkeep

# Backup Dumps & Database Archives
*.sql
*.sql.gz
*.dump
*.tar.gz
*.zip
backups/*.sql
backups/*.sql.gz
backups/*.dump
backups/*.tar.gz
!backups/.gitkeep

# Runtime Logs
*.log
logs/*.log
!logs/.gitkeep

# Machine & OS Specific Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.tmp
*.swp
