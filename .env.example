# Phoxtra Cloud Root Infrastructure Configuration Template
# DO NOT COMMIT REAL SECRETS TO GIT

# Global Platform Settings
ENVIRONMENT=production
DOMAIN=cloud.phoxtra.com

# Appwrite Environment Variables
APPWRITE_VERSION=1.9.6
_APP_ENV=production
_APP_VERSION=1.9.6

# Domain Configuration
_APP_DOMAIN=cloud.phoxtra.com
_APP_DOMAIN_TARGET=cloud.phoxtra.com
_APP_DOMAIN_TARGET_CNAME=cloud.phoxtra.com
_APP_DOMAIN_CONSOLE=cloud.phoxtra.com
_APP_DOMAIN_API=cloud.phoxtra.com

# Console Hostnames
_APP_CONSOLE_HOSTNAMES=localhost,127.0.0.1,cloud.phoxtra.localhost,cloud.phoxtra.com

# Email Configuration
_APP_EMAIL_CERTIFICATES=admin@phoxtra.com
_APP_SYSTEM_EMAIL_NAME=Phoxtra Cloud
_APP_SYSTEM_EMAIL_ADDRESS=phoxmanglobal@gmail.com

# Security and Options
_APP_OPTIONS_FORCE_HTTPS=enabled
APP_SECRET=change_me_app_secret
_APP_OPENSSL_KEY_V1=change_me_openssl_key

# Console Whitelist
# Disabled for open console registration
_APP_CONSOLE_WHITELIST_ROOT=disabled
_APP_CONSOLE_WHITELIST_EMAILS=
_APP_CONSOLE_WHITELIST_DOMAINS=
_APP_CONSOLE_WHITELIST_IPS=

# Database Configuration
_APP_DATABASE_SHARED_TABLES=database_db_main
_APP_DATABASE_SHARED_NAMESPACE=appwrite
_APP_CONNECTIONS_DATABASE=db_main=mariadb://appwrite:change_me_user_password@phoxtra-mariadb:3306/appwrite

# Database Credentials
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=appwrite
MYSQL_USER=appwrite
MYSQL_PASSWORD=change_me_user_password

# Redis Credentials
REDIS_PASSWORD=
_APP_REDIS_USER=

# TLS / SSL Certificate Contact Email
LETSENCRYPT_EMAIL=admin@phoxtra.com
